{
  "name": "opencode-telegram-bot",
  "version": "0.1.0",
  "description": "Securely control a private OpenCode agent from Telegram.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && prettier --check .",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "opencode",
    "telegram",
    "bot",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bani2016up/opencode-telegram-bot.git"
  },
  "bugs": "https://github.com/bani2016up/opencode-telegram-bot/issues",
  "homepage": "https://github.com/bani2016up/opencode-telegram-bot#readme",
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.25",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "grammy": "^1.46.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
