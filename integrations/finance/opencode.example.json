{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "finance": {
      "type": "local",
      "command": [
        "/absolute/path/to/integrations/finance/.venv/bin/python",
        "/absolute/path/to/integrations/finance/finance.py",
        "stdio"
      ],
      "environment": {
        "FINANCE_CONFIG": "/absolute/path/to/finance/config.json"
      },
      "enabled": true
    }
  }
}
