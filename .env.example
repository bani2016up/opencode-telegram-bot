# Obtain this from @BotFather. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace-me

# Numeric Telegram IDs only. Usernames are optional labels and are never trusted.
TELEGRAM_ADMIN_USER_IDS=123456789
TELEGRAM_ADMIN_USERNAMES=example_admin

# OpenCode must listen only on loopback.
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-random-password

# Runtime state and workspace settings.
DATABASE_PATH=./data/bot.sqlite
DEFAULT_WORKDIR=/home/agent
AGENT_HOME=/home/agent
ALLOWED_WORKSPACE_ROOTS=/home/agent

# Operational limits.
ACCESS_REQUEST_TTL_SECONDS=900
CALLBACK_TTL_SECONDS=600
MAX_PROMPT_LENGTH=12000
STREAM_INTERVAL_MS=500
LOG_LEVEL=info
